# Pinned versions. In an air-gapped network you only ever run what you've bundled and verified.
# Python, Prometheus, Alertmanager and Grafana match airgapped-observability-lab, so images already approved there are reused.
PYTHON_VERSION=3.12.11-alpine3.22
TELEGRAF_VERSION=1.40.2-alpine
PROMETHEUS_VERSION=v3.5.0
ALERTMANAGER_VERSION=v0.28.1
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB
GRAFANA_VERSION=12.1.0


# Grafana's admin account. Docker compose refuses to run anything until a password is set here.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=